      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"capy-pos-api\" } | rate() by (span.http.route)",
          "limit": 20,
          "filters": []
        }
      ]
    },
