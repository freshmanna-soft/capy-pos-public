    {
      "id": 6,
      "title": "Backend Errors (CloudWatch) \u2014 Lambda Errors & API 5xx",
      "type": "timeseries",
      "description": "Sourced from AWS CloudWatch, not OTel. Catches Lambda init crashes / unhandled errors / API Gateway 5xx that emit no traces. Requires the gated CloudWatch datasource (set grafana_cw_access_key/secret_key).",
      "datasource": {
        "type": "cloudwatch",
        "uid": "capy-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "capy-cloudwatch"
          },
          "namespace": "AWS/Lambda",
          "metricName": "Errors",
          "statistic": "Sum",
          "dimensions": {
            "FunctionName": "*"
          },
          "matchExact": false,
          "region": "default",
          "label": "Lambda Errors",
          "metricQueryType": 0,
          "metricEditorMode": 0
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "capy-cloudwatch"
          },
          "namespace": "AWS/ApiGateway",
          "metricName": "5xx",
          "statistic": "Sum",
          "dimensions": {
            "ApiId": "*"
          },
          "matchExact": false,
          "region": "default",
          "label": "API Gateway 5xx",
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      ]
    }
