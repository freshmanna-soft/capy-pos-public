      "title": "HTTP Request Rate (by route)",
      "type": "timeseries",
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
