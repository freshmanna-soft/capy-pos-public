#!/usr/bin/env sh

# 🛡️ Protected branch guard — block direct pushes to main
# main requires PRs; direct push (including force push) is rejected locally.
PROTECTED_BRANCH="main"
ZERO_SHA="0000000000000000000000000000000000000000"

# git feeds the pushed refs on stdin once; keep them for every gate below.
PUSH_REFS=$(cat)

while read local_ref local_sha remote_ref remote_sha; do
  remote_branch=$(echo "$remote_ref" | sed 's|refs/heads/||')
  if [ "$remote_branch" = "$PROTECTED_BRANCH" ]; then
    echo ""
    echo "🚫 PUSH REJECTED: Direct push to '$PROTECTED_BRANCH' is not allowed."
    echo "   The '$PROTECTED_BRANCH' branch is protected and requires a Pull Request."
    echo ""
    echo "   To push your feature branch instead:"
    echo "     git push origin <your-branch-name>"
    echo ""
    echo "   Then create a PR:"
    echo "     gh pr create --base main"
    echo ""
    exit 1
  fi
done <<EOF
$PUSH_REFS
EOF

# 🏗️ Terraform gate — only for pushes that touch terraform/. Validates an
# exported copy of each pushed commit (see scripts/terraform-check.sh); fails
# loudly if terraform is missing rather than skipping.
while read local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO_SHA" ] && continue # branch deletion
  if [ "$remote_sha" != "$ZERO_SHA" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    base="$remote_sha"
  else
    # New branch (or remote tip not fetched): diff against where it forked.
    base=$(git merge-base "$local_sha" origin/dev 2>/dev/null || git merge-base "$local_sha" origin/main 2>/dev/null || true)
  fi
  if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" -- terraform/; then
    sh scripts/terraform-check.sh "$local_sha" || {
      echo "   Push aborted."
      exit 1
    }
  fi
done <<EOF
$PUSH_REFS
EOF

echo "🧪 Running E2E Playwright tests before push..."
echo "   This gate ensures no disconnected features or UX regressions are pushed."
echo ""

# Formatting, for src/ and infra/ alike (#393): infra/ was never gated, and drifted.
npm run format:check
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Formatting check failed. Push aborted."
  echo "   Run 'npm run format' to fix it."
  exit 1
fi

# Type-check everything, specs included. Vitest does not check types, so this is
# the only thing that fails on a stale spec or a vacuous @ts-expect-error.
npm run typecheck
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Type check failed. Push aborted."
  echo "   Run 'npm run typecheck' to see the errors."
  exit 1
fi

# Run unit tests WITH coverage (enforces 90% threshold gate)
npm run test:unit -- --coverage
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Unit tests or coverage threshold failed. Push aborted."
  echo "   Fix failing tests or increase coverage before pushing."
  exit 1
fi

# Run affected E2E Playwright tests (deterministic git-diff selection, chromium only).
# Always includes the persona-workflows navigation floor; escalates to the full
# suite on core/shared/config changes. See scripts/affected-e2e.mjs.
npm run test:e2e:affected
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ E2E Playwright tests failed. Push aborted."
  echo "   Possible issues:"
  echo "   - Disconnected feature (route without navigation link)"
  echo "   - UX regression (search results clearing on selection)"
  echo "   - Broken persona workflow"
  echo ""
  echo "   Run 'npm run test:e2e' locally to debug, or"
  echo "   'npm run test:e2e:affected -- --list' to see what was selected."
  exit 1
fi

echo ""
echo "✅ All tests passed. Push proceeding."
