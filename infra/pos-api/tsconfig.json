{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Source imports name the real files (`./store.ts`), because both
    // `npm start` and `npm test` run the TypeScript directly under Node's type
    // stripping and Node will not guess that a `.js` specifier means a `.ts` file
    // on disk. These two options let that same source compile: TS accepts the
    // `.ts` specifier and rewrites it to `.js` in `dist/`, so the Lambda bundle
    // keeps working. Carried over verbatim from infra/vision-proxy — the two
    // packages are siblings, and a relay that resolved its imports differently
    // would be a second convention to remember.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Type stripping cannot tell a type import from a value one, so a type left in
    // a value import crashes `npm start` at load. This turns that into a build error.
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    // `..`, not `src`: `api.ts` and `server.ts` import the DocumentStore port from
    // `infra/shared/` (story #204), and `rootDir` has to contain every input file or
    // tsc refuses the program with TS6059. The cost is that emit mirrors the tree
    // from `infra/` down — `dist/pos-api/src/server.js`, `dist/shared/src/…` — so a
    // Dockerfile for this service builds from the `infra/` context and starts
    // `dist/pos-api/src/server.js`, unlike the two sibling services' flat
    // `dist/server.js`. `infra/shared/README.md` spells that out; there is no
    // Dockerfile here yet to break.
    "rootDir": "..",
    "skipLibCheck": true,
    "types": ["node"]
  },
  // The `.test.mjs` suites are deliberately outside this: they are plain JavaScript
  // run by `node --test`, they import the stripped `.ts` sources at runtime, and
  // nothing typechecks them. That is the same trade `scripts/graphrag`'s `.mjs`
  // suites already make in this repo.
  "include": ["src/**/*.ts"]
}
