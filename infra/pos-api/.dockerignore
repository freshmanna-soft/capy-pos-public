# Keep the build context to the sources the image is built from. `node_modules`
# especially: it is installed inside the image for the target platform, and copying
# a host one in would ship a tree built for the wrong architecture.
node_modules/
dist/
.env
.env.example
*.log

# Dev-only tooling. The suite runs in CI (`.github/workflows/ci.yml`) and the smoke
# script runs against a deployed revision, so neither belongs in the runtime image.
src/**/*.test.mjs
smoke.mjs
