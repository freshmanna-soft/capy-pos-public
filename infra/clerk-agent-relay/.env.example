# The model key. Put it in your secrets manager, not here.
ANTHROPIC_API_KEY=sk-ant-...

# The secret this service verifies session tokens with. It must be byte-identical to
# the one the browser signs them with — `getJwtSecret()` in
# src/app/core/infrastructure/auth/session-issuer.ts. A mismatch is a 401 on every
# call, which looks exactly like a broken login. The service refuses to start
# without it.
SESSION_JWT_SECRET=capy-pos-local-jwt-secret-change-in-production

# Comma-separated browser origins this service will answer. No wildcard: the origin
# is echoed back only when it is on this list. The service refuses to start without
# it — and it matters more here than on the vision proxy, because this endpoint holds
# tools that change a cart, so anything that can reach it can spend the shop's model
# key *and* drive the till.
# In Code Engine this comes from `var.frontend_origins` (terraform/variables.tf).
ALLOWED_ORIGINS=http://localhost:4200

# Local dev server only. Code Engine sets PORT itself. 8787 is the vision proxy's
# default and 8788 is what `npm run vision:proxy` already takes, so the relay starts
# one along.
PORT=8789
